# ==============================================================================
# Jornada360 — OPÇÃO A: publicação gratuita (Render + Turso)
#
# Estes valores vão no painel do Render (Environment), não num arquivo enviado ao repositório.
# Este exemplo existe para você conferir se não faltou nenhum.
#
# O servidor RECUSA SUBIR se algo aqui estiver inseguro — se o deploy falhar, o log diz qual
# variável está errada. Ver DEPLOY_GRATUITO.md.
# ==============================================================================

NODE_ENV=production

# A API serve o frontend construído: é o que mantém página e cookie na MESMA origem.
JORNADA_SERVIR_FRONTEND=1

# ------------------------------------------------------------------ banco (Turso)
# Sem disco persistente na hospedagem gratuita, o banco precisa viver fora da máquina.
# Os dois valores saem do painel do Turso. O token é segredo.
JORNADA_DB_URL=libsql://seu-banco-seu-usuario.turso.io
JORNADA_DB_TOKEN=cole-o-token-aqui

# NÃO defina JORNADA_DB_PATH junto: quando JORNADA_DB_URL existe, é ela que vale.

# ------------------------------------------------------------------ endereço público
# Só é conhecido depois do primeiro deploy. Suba, copie a URL do Render, preencha as duas e
# faça o deploy de novo.
JORNADA_URL_PUBLICA=https://jornada360.onrender.com
JORNADA_CORS_ORIGENS=https://jornada360.onrender.com

# ------------------------------------------------------------------ sessão
JORNADA_COOKIE_SEGURO=1
# O Render fica atrás de um proxy: sem isto o limite de tentativas de senha veria o IP do proxy
# em todas as requisições e trataria todo mundo como a mesma pessoa.
JORNADA_TRUST_PROXY=1

# ------------------------------------------------------------------ e-mail
# "desativado" publica sem envio: recuperação de senha e convite passam a exigir entrega manual
# do código, e a interface diz isso — nenhum modo finge que enviou.
# Troque para smtp quando tiver um provedor (há camadas gratuitas).
JORNADA_EMAIL_MODO=desativado
# JORNADA_EMAIL_MODO=smtp
# JORNADA_SMTP_URL=smtps://usuario:senha@smtp.provedor.com:465
# JORNADA_EMAIL_REMETENTE=Jornada360 <nao-responda@seu-dominio>

# ------------------------------------------------------------------ NÃO definir aqui
# JORNADA_CADASTRO_ABERTO — em produção nasce fechado, e é assim que o piloto controla quem entra.
# JORNADA_BACKUP_DIR      — o disco é efêmero; o backup do banco remoto é `npm run exportar`.
# JORNADA_BACKUP_INTERVALO_HORAS — o serviço hiberna, então o cronômetro interno para junto.
